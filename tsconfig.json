{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "app.ts",
    "server.ts",
    "config/**/*.ts",
    "db/**/*.ts",
    "modules/**/*.ts",
    "common/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
